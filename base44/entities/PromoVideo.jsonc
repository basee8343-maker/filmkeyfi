{
  "name": "PromoVideo",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "duration": {
      "type": "integer",
      "default": 60
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "size_bytes": {
      "type": "integer"
    }
  },
  "required": [
    "title",
    "file_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}