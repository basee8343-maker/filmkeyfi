{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "provider",
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}