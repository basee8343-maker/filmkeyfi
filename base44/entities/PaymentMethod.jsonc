{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "provider_key": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "card",
        "other"
      ],
      "default": "other"
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "bank_name": {
      "type": "string"
    },
    "account_holder": {
      "type": "string"
    },
    "iban": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "payment_instructions": {
      "type": "string"
    },
    "merchant_id": {
      "type": "string"
    },
    "test_mode": {
      "type": "boolean",
      "default": false
    },
    "required_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "provider_key",
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}