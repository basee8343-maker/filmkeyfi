{
  "name": "RoomMessage",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "user_avatar": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "user",
        "system"
      ],
      "default": "user"
    }
  },
  "required": [
    "room_id",
    "text"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}