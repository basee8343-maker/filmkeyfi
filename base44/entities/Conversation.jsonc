{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "user1_id": {
      "type": "string"
    },
    "user1_name": {
      "type": "string"
    },
    "user1_avatar": {
      "type": "string"
    },
    "user2_id": {
      "type": "string"
    },
    "user2_name": {
      "type": "string"
    },
    "user2_avatar": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deleted_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "offline_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "read_receipts_disabled_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "last_message_text": {
      "type": "string",
      "default": ""
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sender_id": {
      "type": "string",
      "default": ""
    },
    "last_sender_name": {
      "type": "string",
      "default": ""
    },
    "unread_user1": {
      "type": "integer",
      "default": 0
    },
    "unread_user2": {
      "type": "integer",
      "default": 0
    },
    "typing_user_id": {
      "type": "string"
    },
    "typing_updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user1_id",
    "user2_id",
    "members"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.user1_id": "{{user.id}}"
        },
        {
          "data.user2_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}