{
  "name": "Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "quality": {
      "type": "string"
    },
    "devices": {
      "type": "integer"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "watch_party": {
      "type": "boolean",
      "default": false
    },
    "voice_chat": {
      "type": "boolean",
      "default": false
    },
    "premium_content": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "duration_days": {
      "type": "integer",
      "default": 30
    },
    "shopier_payment_url": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}