{
  "name": "FriendshipProgression",
  "type": "object",
  "properties": {
    "pair_key": {
      "type": "string"
    },
    "user_a_id": {
      "type": "string"
    },
    "user_b_id": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_messages": {
      "type": "integer",
      "default": 0
    },
    "level": {
      "type": "integer",
      "default": 1
    },
    "current_level_message_count": {
      "type": "integer",
      "default": 0
    },
    "last_counted_message_id": {
      "type": "string"
    }
  },
  "required": [
    "pair_key",
    "user_a_id",
    "user_b_id",
    "members"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}