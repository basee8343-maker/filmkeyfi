{
  "name": "XpSettings",
  "type": "object",
  "properties": {
    "xp_per_message": {
      "type": "integer",
      "minimum": 0,
      "default": 10
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}