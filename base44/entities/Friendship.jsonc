{
  "name": "Friendship",
  "type": "object",
  "properties": {
    "requester_id": {
      "type": "string"
    },
    "requester_name": {
      "type": "string"
    },
    "requester_member_id": {
      "type": "string"
    },
    "requester_avatar": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "recipient_member_id": {
      "type": "string"
    },
    "recipient_avatar": {
      "type": "string"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cleared_at": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "format": "date-time"
      },
      "default": {}
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "typing_user_id": {
      "type": "string"
    },
    "typing_updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "removed",
        "blocked"
      ],
      "default": "pending"
    }
  },
  "required": [
    "requester_id",
    "recipient_id",
    "members",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.members": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}