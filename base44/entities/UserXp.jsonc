{
  "name": "UserXp",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "xp": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "message_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "manual_frame_id": {
      "type": "string",
      "default": ""
    },
    "last_message_id": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}