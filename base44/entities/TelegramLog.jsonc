{
  "name": "TelegramLog",
  "type": "object",
  "properties": {
    "event_type": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "message": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "failed"
      ],
      "default": "sent"
    },
    "error": {
      "type": "string"
    },
    "ref_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    }
  },
  "required": [
    "event_type",
    "recipient",
    "message",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}