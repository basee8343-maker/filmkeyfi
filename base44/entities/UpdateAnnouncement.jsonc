{
  "name": "UpdateAnnouncement",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}