{
  "name": "Room",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "movie_id": {
      "type": "string"
    },
    "movie_title": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "room_number": {
      "type": "integer",
      "default": 0
    },
    "max_users": {
      "type": "integer",
      "default": 10
    },
    "chat_enabled": {
      "type": "boolean",
      "default": true
    },
    "voice_enabled": {
      "type": "boolean",
      "default": false
    },
    "is_playing": {
      "type": "boolean",
      "default": false
    },
    "current_time": {
      "type": "number",
      "default": 0
    },
    "last_sync": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "muted": {
            "type": "boolean"
          },
          "speaking": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "name",
    "movie_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.hidden": false
        },
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.participants.user_id": "{{user.id}}"
        }
      ]
    },
    "create": {},
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}