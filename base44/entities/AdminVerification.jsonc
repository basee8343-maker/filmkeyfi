{
  "name": "AdminVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "token_fingerprint": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "token_fingerprint",
    "expires_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "_backend_only"
      }
    },
    "create": {
      "user_condition": {
        "role": "_backend_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "_backend_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "_backend_only"
      }
    }
  }
}