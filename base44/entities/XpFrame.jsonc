{
  "name": "XpFrame",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "min_xp": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "style": {
      "type": "string",
      "enum": [
        "starter",
        "blue",
        "green",
        "cyan",
        "violet",
        "pink",
        "fire",
        "gold",
        "ice",
        "legend"
      ],
      "default": "starter"
    },
    "image_url": {
      "type": "string",
      "default": ""
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "animated": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "name",
    "min_xp"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}